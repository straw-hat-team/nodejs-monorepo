{
  "private": true,
  "name": "@straw-hat/cli",
  "version": "0.10.3",
  "description": "Straw Hat Team CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/straw-hat-team/nodejs-monorepo.git",
    "directory": "packages/tooling/cli"
  },
  "keywords": [
    "oclif",
    "cli",
    "straw-hat-team"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "experimental:build": "pnpm run prebuild && tsc -p tsconfig.prod.json",
    "prepack": "pnpm run build && pnpm run oclif:manifest",
    "postpack": "rimraf oclif.manifest.json",
    "docs:typedoc": "typedoc",
    "oclif:manifest": "oclif manifest dist",
    "oclif:readme": "oclif readme --multi  --dir=docs/commands"
  },
  "bin": {
    "shc": "bin/run"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "docs",
    "oclif.manifest.json",
    "README.md"
  ],
  "dependencies": {
    "@oclif/core": "5.1.9",
    "@oclif/plugin-help": "7.0.6",
    "@oclif/plugin-version": "3.0.7",
    "@straw-hat/cli-core": "workspace:*",
    "@straw-hat/jest-config-chain": "workspace:*",
    "cypress": "^16.2.0",
    "debug": "4.4.3",
    "del": "9.0.1",
    "enquirer": "2.4.1",
    "envinfo": "7.21.0",
    "jest": "30.5.2",
    "jest-cli": "30.5.2",
    "jest-watch-typeahead": "3.0.1"
  },
  "devDependencies": {
    "@oclif/dev-cli": "1.26.10",
    "@straw-hat/tsconfig": "workspace:*",
    "@types/node": "^26.6.5"
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "shc",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-version"
    ],
    "topicSeparator": " ",
    "topics": {
      "gen": {
        "description": "multiple generators"
      },
      "cypress": {
        "description": "cypress commands"
      }
    }
  }
}
