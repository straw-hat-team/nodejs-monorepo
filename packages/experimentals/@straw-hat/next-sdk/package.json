{
  "name": "@straw-hat/next-sdk",
  "version": "0.5.1",
  "description": "A Software Development Kit for NextJS",
  "repository": {
    "type": "git",
    "url": "https://github.com/straw-hat-team/nodejs-monorepo.git",
    "directory": "packages/@straw-hat/next-sdk"
  },
  "license": "MIT",
  "keywords": [
    "straw-hat-team",
    "nextjs",
    "next",
    "react",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "experimental:build": "pnpm run prebuild && tsc -p tsconfig.prod.json",
    "experimental:test:vitest": "vitest",
    "prepack": "pnpm run build",
    "docs:typedoc": "typedoc"
  },
  "type": "module",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "next": "^12.0.4",
    "react": "^17.0.2"
  },
  "dependencies": {
    "@straw-hat/types": "workspace:^"
  },
  "devDependencies": {
    "@straw-hat/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "jsdom": "^30.0.1",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
